# Copy to apps/api/.env for running the API/worker outside Docker (npm run dev:api / dev:worker).
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/competitor_pulse?schema=public
REDIS_URL=redis://localhost:6379
LISTING_SOURCE_URL=http://localhost:4002
LISTING_SOURCE_TIMEOUT_MS=5000

# LLM: the provided mock server speaks the OpenAI Chat Completions shape.
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=not-needed-for-mock
LLM_MODEL=mock-llm
LLM_TIMEOUT_MS=10000
LLM_MAX_ATTEMPTS=5
LLM_RATE_PER_SEC=5
SUMMARY_CONCURRENCY=4

# Scheduling. Production would be POLL_INTERVAL_SECONDS=900 (15 min).
POLL_INTERVAL_SECONDS=20
POLL_JITTER_RATIO=0.1
SCHEDULER_TICK_SECONDS=5
POLL_BATCH_SIZE=100
POLL_CONCURRENCY=10
POLL_MAX_ATTEMPTS=3
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_PENDING_AFTER_SECONDS=120

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
